{
  "name": "apiweiser-cli",
  "version": "4.0.0",
  "description": "Dependency upgrades for coding agents: finds where each package is used, which updates must move together, their release notes and codemods - as JSON commands plus an agent skill.",
  "bin": {
    "apiweiser-cli": "dist/main.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r src/dashboard/static dist/dashboard/static",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enismustafaj/apiweiser-cli"
  },
  "keywords": [
    "cli",
    "dependencies",
    "codemod",
    "breaking-changes",
    "renovate"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/enismustafaj/apiweiser-scanner/issues"
  },
  "homepage": "https://github.com/enismustafaj/apiweiser-scanner#readme",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "commander": "^15.0.0",
    "hono": "^4.13.7",
    "semver": "^7.8.5",
    "ts-morph": "^28.0.0"
  }
}
