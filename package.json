{
  "name": "apiweiser-cli",
  "version": "1.0.0",
  "description": "Watches a repo's dependencies, classifies breaking releases via an LLM, and has a coding agent build, test, and open a PR for the migration.",
  "bin": {
    "apiweiser-cli": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enismustafaj/apiweiser-cli"
  },
  "keywords": [
    "cli",
    "dependencies",
    "codemod",
    "breaking-changes",
    "renovate"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/enismustafaj/apiweiser-scanner/issues"
  },
  "homepage": "https://github.com/enismustafaj/apiweiser-scanner#readme",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "node-cron": "^4.6.0",
    "openai": "^7.10.0",
    "ts-morph": "^28.0.0"
  }
}
